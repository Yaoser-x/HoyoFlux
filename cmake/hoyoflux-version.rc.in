#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @HoyoFlux_VERSION_MAJOR@,@HoyoFlux_VERSION_MINOR@,@HoyoFlux_VERSION_PATCH@,0
 PRODUCTVERSION @HoyoFlux_VERSION_MAJOR@,@HoyoFlux_VERSION_MINOR@,@HoyoFlux_VERSION_PATCH@,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "HoyoFlux session controller"
      VALUE "ProductName",     "HoyoFlux"
      VALUE "FileVersion",     "@HOYOFLUX_VERSION_STRING@"
      VALUE "ProductVersion",  "@HOYOFLUX_VERSION_STRING@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
